{
  "name": "aatha-pooja",
  "version": "1.0.0",
  "description": "Transparent Amman pooja desktop overlay",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build:electron": "node scripts/build.mjs",
    "build": "tsc --noEmit && vite build && node scripts/build.mjs && electron-builder",
    "dist": "npm run build",
    "start": "vite build && node scripts/build.mjs && electron ."
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "electron": "^44.8.0",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.25.0",
    "typescript": "^5.5.3",
    "vite": "^6.4.4"
  },
  "overrides": {
    "global-agent": "^4.1.3",
    "sprintf-js": "^1.1.3"
  },
  "build": {
    "appId": "com.gokul.ayudhapooja",
    "productName": "Ayudha Pooja",
    "files": [
      "dist/**",
      "dist-electron/**"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Ayudha Pooja"
    }
  }
}
